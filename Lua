local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 170)
status.Position = UDim2.new(0, 0, 0.62, 0)
status.BackgroundTransparency = 1
status.Text = "Forcing: GameStat_Money + stat_Money + leaderstats"
status.TextColor3 = Color3.fromRGB(255, 100, 100)
status.TextScaled = true
status.TextWrapped = true
status.Parent = frame

local targetAmount = 25000000
local enabled = false
local conn = nil

local function preciseForce(amount)
    -- Leaderstats (leaderboard)
    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local m = ls:FindFirstChild("Money")
        if m then m.Value = amount end
    end

    -- Precise targets from your Dex
    for _, v in pairs(player:GetDescendants()) do
        if v.Name == "GameStat_Money" or v.Name == "stat_Money" then
            if v:IsA("NumberValue") or v:IsA("IntValue") then
                v.Value = amount
            end
        end
    end

    -- Backup: Force ALL number values (for GUI sync)
    for _, v in pairs(player:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntValue") then
            v.Value = amount
        end
    end
end

enableBtn.MouseButton1Click:Connect(function()
    local amt = tonumber(amountBox.Text)
    if amt then targetAmount = math.floor(amt) end
    enabled = true

    if conn then conn:Disconnect() end
    conn = RunService.Heartbeat:Connect(function()
        if enabled then preciseForce(targetAmount) end
    end)

    status.Text = "💀 PRECISE ATTACK ACTIVE\nTargeting GameStat_Money + stat_Money"
end)

stopBtn.MouseButton1Click:Connect(function()
    enabled = false
    if conn then conn:Disconnect() end
    status.Text = "Stopped"
end)
