-- FINAL MAX FORCE v12 | RAYFIELD VERSION

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- RAYFIELD
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "💀 FINAL MAX FORCE v12",
    LoadingTitle = "FINAL MAX FORCE",
    LoadingSubtitle = "Rayfield UI",
    ConfigurationSaving = {
        Enabled = false,
    },
    Discord = {
        Enabled = false,
    },
    KeySystem = false,
})

-- TAB
local MainTab = Window:CreateTab("Main", 4483362458)

-- VARIABLES
local target = 25000000
local enabled = false
local conn = nil

-- INPUT
MainTab:CreateInput({
    Name = "Money Amount",
    PlaceholderText = "25000000",
    RemoveTextAfterFocusLost = false,
    Callback = function(Text)
        local amt = tonumber(Text)
        if amt then
            target = math.floor(amt)
        end
    end,
})

-- ENABLE BUTTON
MainTab:CreateButton({
    Name = "ENABLE FINAL FORCE",
    Callback = function()
        enabled = true

        if conn then
            conn:Disconnect()
        end

        conn = RunService.Heartbeat:Connect(function()
            if not enabled then
                return
            end

            -- leaderstats
            local ls = player:FindFirstChild("leaderstats")

            if ls and ls:FindFirstChild("Money") then
                ls.Money.Value = target
            end

            -- all possible money values
            for _, v in pairs(player:GetDescendants()) do
                if v.Name == "GameStat_Money"
                or v.Name == "stat_Money"
                or v.Name == "Money" then

                    if v:IsA("NumberValue") or v:IsA("IntValue") then
                        v.Value = target
                    end
                end
            end
        end)

        Rayfield:Notify({
            Title = "FINAL FORCE ACTIVE",
            Content = "Target → " .. tostring(target),
            Duration = 5,
            Image = 4483362458,
        })
    end,
})

-- STOP BUTTON
MainTab:CreateButton({
    Name = "STOP",
    Callback = function()
        enabled = false

        if conn then
            conn:Disconnect()
        end

        Rayfield:Notify({
            Title = "FORCE STOPPED",
            Content = "Script Disabled",
            Duration = 4,
            Image = 4483362458,
        })
    end,
})

-- INFO LABEL
MainTab:CreateParagraph({
    Title = "Status",
    Content = "Running maximum client force...\nIf it still drops → Server is strong"
})
